# Servidor estatico do painel.
#
# Caddy em vez de um servidor Bun proprio: os cabecalhos de seguranca do `security.md` §3 sao
# declarativos aqui, e um SPA servido a mao sempre acaba reimplementando fallback, cache e MIME
# pior do que um servidor pronto.
#
# `{$VAR}` e substituido quando o Caddy carrega a config, entao API_ORIGIN e variavel de ambiente
# do servico — o mesmo bundle nao serve para dois ambientes, mas o CSP acompanha o ambiente.

{
	admin off
	# TLS quem termina e o Railway; o container fala HTTP puro na porta interna.
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	header {
		-Server
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# `microphone=(self)`: o composer do conversations-ui grava audio.
		Permissions-Policy "camera=(), microphone=(self), geolocation=(), payment=(), usb=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# `style-src` ainda precisa de 'unsafe-inline' porque o conversations-ui usa `style={{...}}`,
		# que vira atributo inline. Nao ha hash possivel para atributo sem 'unsafe-hashes'.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: {$API_ORIGIN}; media-src 'self' blob: {$API_ORIGIN}; font-src 'self' data:; connect-src 'self' {$API_ORIGIN}; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; form-action 'self'"
	}

	# Asset com hash no nome pode ser eterno; o index nunca, senao o deploy novo nao chega.
	@hashedAssets path /assets/*
	header @hashedAssets Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-store"

	try_files {path} /index.html
	file_server
}
