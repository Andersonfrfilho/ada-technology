PROJECT_NAME=ada
ENV=dev
NODE_ENV=development

APP_NAME=api-ada
API_PORT=3401
API_PUBLIC_URL=http://localhost:3401
LOG_LEVEL=debug

DATABASE_URL=postgres://ada:ada@localhost:5434/ada_dev
REDIS_URL=redis://localhost:6381
ADA_COMPANY_ID=fb2298b4-084d-4f12-bd98-df5b46a13bb1

# Allowlist explicita de origens — nunca "*" em rota autenticada
CORS_ALLOWED_ORIGINS=http://localhost:5176,http://localhost:5175

# Sessao do painel (agentes). Gere com: openssl rand -hex 32
PANEL_JWT_SECRET=dev-only-nao-use-em-producao-troque-me-agora-000000
PANEL_ACCESS_TOKEN_TTL_MINUTES=15
PANEL_RESET_URL_TEMPLATE=http://localhost:5173/reset-password?token={token}

# Widget do site: origens autorizadas a abrir conversa
WIDGET_ALLOWED_ORIGINS=http://localhost:5176

# WhatsApp Cloud API (Meta). Sem estes valores o canal WhatsApp nao sobe.
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_BASE_URL=http://localhost:8080
META_CATALOG_ID=
META_CATALOG_ACCESS_TOKEN=
META_CATALOG_WEBHOOK_VERIFY_TOKEN=

# Bucket S3-compativel do MinIO local (infra/docker-compose.yml). Vazio desliga o upload de imagem:
# o modulo nao publica a rota e o painel volta ao campo de URL digitada.
OBJECT_STORAGE_ENDPOINT=http://localhost:9004
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY_ID=ada
OBJECT_STORAGE_SECRET_ACCESS_KEY=ada-local-dev
OBJECT_STORAGE_BUCKET=ada-products
OBJECT_STORAGE_PUBLIC_BASE_URL=http://localhost:9004/ada-products

# Classificador de intencao opcional (Groq free tier). Desligado por padrao:
# fora do fluxo, a conversa vai para atendimento humano.
INTENT_CLASSIFIER_ENABLED=false
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_MODEL=llama-3.3-70b-versatile
