// Config separada porque o widget roda no browser: `types: []` no tsconfig principal e o que impede
// um `Bun.file` ou um global de Node passar despercebido no codigo que vai para a pagina do cliente.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["bun"]
  },
  "include": ["src/**/*.test.ts"],
  "exclude": []
}
